{
  "schema": 1,
  "scope": "Shared semantic and optical acceptance inventory for Petrucci proof rendering and LilyPond publication export.",
  "profiles": ["petrucci", "classic"],
  "publication_engines": {
    "baseline": "2.26",
    "compatibility": "2.24"
  },
  "microcases": [
    {
      "id": "collision-layout",
      "case": "polyphonic-collisions",
      "assertions": [
        "same-onset voices remain distinguishable",
        "layout collision report is empty"
      ]
    },
    {
      "id": "tab-rhythm-export",
      "case": "tab-registration-and-rhythm",
      "assertions": [
        "rhythm marks share the note onset column",
        "dotted values remain explicit in the export"
      ]
    },
    {
      "id": "mixed-voice-lute-lyrics-export",
      "case": "voice-lute-lyrics",
      "assertions": [
        "voice and lute staves share one registration",
        "lyrics remain attached to the vocal staff"
      ]
    },
    {
      "id": "fermata-export",
      "case": "fermata",
      "assertions": [
        "a fermata sits over the note it belongs to",
        "the export marks the bar with a fermata glyph"
      ]
    },
    {
      "id": "cut-time-export",
      "case": "cut-time",
      "assertions": [
        "cut time draws a time signature in the layout",
        "the export states 2/2"
      ]
    },
    {
      "id": "key-signature-export",
      "case": "key-signature",
      "assertions": [
        "one sharp is drawn as a key signature",
        "the export states G major"
      ]
    },
    {
      "id": "tuplet-export",
      "case": "tuplet-triplet",
      "assertions": [
        "a triplet group gets one bracket over its notes",
        "the export writes a tuplet block, not scaled durations"
      ]
    }
  ],
  "upstream_microcases": [
    {
      "id": "partial-grace-beams",
      "test": "test_upstream_partial_beamlets_and_grace_stay_inside_repeat_measure",
      "sources": [
        "LilyPond 2.24.4 input/regression/auto-beam-partial-grace.ly",
        "LilyPond 2.24.4 input/regression/beam-beamlet-break.ly",
        "MuseScore 4.6.0 src/engraving/tests/beam_data"
      ],
      "invariant": "partial and grace beamlets stay registered inside repeat measures"
    },
    {
      "id": "grouped-tuplets",
      "test": "test_upstream_tuplet_group_gets_one_bracket_without_losing_beam",
      "sources": [
        "LilyPond 2.24.4 tuplet and auto-beam regression family",
        "MuseScore 4.6.0 compat114_data/tuplets*.mscx"
      ],
      "invariant": "one tuplet bracket and one beam group share the same event span"
    },
    {
      "id": "broken-spans-volta",
      "test": "test_upstream_broken_spans_coexist_with_volta_and_repeat_barlines",
      "sources": [
        "LilyPond 2.24.4 input/regression/tie-broken.ly",
        "LilyPond 2.24.4 input/regression/bar-line-allow-volta-hook.ly",
        "MuseScore 4.6.0 partialtie_data/repeat_barlines.mscx"
      ],
      "invariant": "broken ties and slurs retain continuation endpoints beside volta and repeat barlines"
    },
    {
      "id": "registered-annotation-lanes",
      "test": "test_measure_spans_dynamics_and_lyrics_have_distinct_reserved_lanes",
      "sources": [
        "LilyPond 2.24.4 annotation, lyric, and dynamic regression families",
        "MuseScore 4.6.0 lyrics and annotation test families"
      ],
      "invariant": "annotations reserve distinct lanes without changing note onset registration"
    }
  ],
  "cases": [
    {
      "id": "tab-registration-and-rhythm",
      "fixture": "tab-registration-and-rhythm",
      "features": ["tablature", "rhythm-flags", "barlines", "partial-beams"],
      "proof": {
        "min_events": 2,
        "min_staffs": 1,
        "required_roles": ["notehead"],
        "max_collisions": 0
      },
      "lilypond": {
        "contains": ["\\new TabStaff", "\\tabFullNotation"]
      },
      "petrucci_contract": ["one onset column per chord", "rhythm marks register with chord onsets"],
      "lilypond_contract": ["TabStaff", "tabFullNotation", "stable thin/thick line hierarchy"],
      "upstream": [
        {
          "project": "LilyPond",
          "version": "2.24.4",
          "fixture": "input/regression/auto-beam-partial.ly",
          "borrowed_invariant": "partial measures do not shift or invent beam groups"
        },
        {
          "project": "LilyPond",
          "version": "2.24.4",
          "fixture": "input/regression/beam-beamlet-break.ly",
          "borrowed_invariant": "beamlet direction and breaks remain deterministic"
        }
      ]
    },
    {
      "id": "voice-lute-lyrics",
      "fixture": "voice-lute-lyrics",
      "features": ["polyphony", "tablature", "lyrics", "staff-group"],
      "proof": {
        "min_events": 4,
        "min_staffs": 2,
        "required_roles": ["staff", "notehead", "lyric"],
        "max_collisions": 0
      },
      "lilypond": {
        "contains": ["\\new StaffGroup <<", "\\new Lyrics", "\\new TabStaff"]
      },
      "petrucci_contract": ["voice and lute remain vertically registered", "lyrics reserve only required rows"],
      "lilypond_contract": ["StaffGroup", "Lyrics", "voice and tablature share bar geometry"],
      "upstream": [
        {
          "project": "MuseScore",
          "version": "4.6.0",
          "fixture": "src/engraving/tests/data/lyrics",
          "borrowed_invariant": "syllables follow voice events without changing rhythmic alignment"
        }
      ]
    },
    {
      "id": "polyphonic-collisions",
      "fixture": "polyphonic-collisions",
      "features": ["seconds", "unisons", "dots", "accidentals", "opposed-stems"],
      "proof": {
        "min_events": 2,
        "min_staffs": 1,
        "required_roles": ["notehead", "accidental"],
        "max_collisions": 0
      },
      "lilypond": {
        "contains": ["\\new TabStaff"]
      },
      "petrucci_contract": ["colliding heads remain distinguishable", "dots and accidentals retain deterministic lanes"],
      "lilypond_contract": ["independent voices", "no collision warnings"],
      "upstream": [
        {
          "project": "MuseScore",
          "version": "4.6.0",
          "fixture": "src/engraving/tests/data/note",
          "borrowed_invariant": "seconds, unisons, dots, and accidentals do not overlap"
        }
      ]
    },
    {
      "id": "broken-spans",
      "fixture": "broken-spans",
      "features": ["ties", "slurs", "system-breaks"],
      "proof": {
        "min_events": 2,
        "min_staffs": 1,
        "required_roles": ["notehead", "tie", "slur"],
        "max_collisions": 0
      },
      "lilypond": {
        "contains": ["~", "(", ")"]
      },
      "petrucci_contract": ["continuation cues survive viewport and system boundaries"],
      "lilypond_contract": ["ties and slurs survive explicit line breaks", "no orphan span fragments"],
      "upstream": [
        {
          "project": "LilyPond",
          "version": "2.24.4",
          "fixture": "input/regression/tie-broken.ly",
          "borrowed_invariant": "broken ties retain both visible endpoints"
        }
      ]
    },
    {
      "id": "repeat-and-volta-registration",
      "fixture": "repeat-and-volta-registration",
      "features": ["repeats", "voltas", "barline-hooks"],
      "proof": {
        "min_events": 1,
        "min_staffs": 1,
        "required_roles": ["notehead", "barline", "ending", "fermata", "ornament"],
        "max_collisions": 0
      },
      "lilypond": {
        "contains": ["\\bar \":|:\""]
      },
      "petrucci_contract": ["repeat signs consume explicit columns", "volta labels do not collide with music"],
      "lilypond_contract": ["repeat barlines and volta hooks compile without warnings"],
      "upstream": [
        {
          "project": "LilyPond",
          "version": "2.24.4",
          "fixture": "input/regression/bar-line-allow-volta-hook.ly",
          "borrowed_invariant": "volta hooks terminate on eligible barlines"
        }
      ]
    },
    {
      "id": "gerbode-multiverse-registration",
      "fixture": "gerbode-multiverse-registration",
      "features": ["mixed-score", "twelve-stanza-lyrics", "editorial-coda", "system-registration"],
      "proof": {
        "min_events": 4,
        "min_staffs": 2,
        "required_roles": ["staff", "notehead", "lyric"],
        "max_collisions": 0
      },
      "lilypond": {
        "contains": ["\\new StaffGroup <<", "\\new Lyrics", "\\new TabStaff"]
      },
      "petrucci_contract": [
        "all syllables survive structured FT3 rows",
        "the final-only coda remains attached to the final stanza"
      ],
      "lilypond_contract": [
        "vocal, lyrics, and tablature share four-bar systems",
        "two systems fit each page without clipping or lyric collisions",
        "editorial intro and coda cues retain their source bars"
      ],
      "real_ft3": "lutemusic/01_felice_fu_quel_anon.ft3",
      "reference": "https://browse.lutemusic.org/sources/BossinensisF/v.2_1511/pdf/01_felice_fu_quel_anon.pdf",
      "upstream": [
        {
          "project": "Gerbode/Fronimo",
          "version": "2020 edition",
          "fixture": "01_felice_fu_quel_anon.pdf",
          "borrowed_invariant": "dense strophic lyrics remain onset-aligned across four registered mixed-score systems"
        }
      ]
    },
    {
      "id": "fermata",
      "fixture": "fermata",
      "origin": "oud",
      "features": ["fermatas"],
      "proof": {
        "min_events": 2,
        "min_staffs": 1,
        "required_roles": ["notehead", "fermata"],
        "max_collisions": 0
      },
      "lilypond": {
        "contains": ["scripts.ufermata"]
      },
      "petrucci_contract": ["a fermata is drawn for the marked event only"],
      "lilypond_contract": ["a bar fermata exports as a fermata glyph mark"],
      "upstream": []
    },
    {
      "id": "cut-time",
      "fixture": "cut-time",
      "origin": "oud",
      "features": ["cut-time", "time-signatures"],
      "proof": {
        "min_events": 2,
        "min_staffs": 1,
        "required_roles": ["notehead", "time-signature"],
        "max_collisions": 0
      },
      "lilypond": {
        "contains": ["\\time 2/2"]
      },
      "petrucci_contract": ["cut time lays out as a 2/2 time signature"],
      "lilypond_contract": ["a C| bar exports as 2/2"],
      "upstream": []
    },
    {
      "id": "key-signature",
      "fixture": "key-signature",
      "origin": "oud",
      "features": ["key-signatures"],
      "proof": {
        "min_events": 2,
        "min_staffs": 1,
        "required_roles": ["notehead", "key-signature"],
        "max_collisions": 0
      },
      "lilypond": {
        "contains": ["\\key g \\major"]
      },
      "petrucci_contract": ["one sharp lays out as a key signature"],
      "lilypond_contract": ["the key setting exports as a \\key command"],
      "upstream": []
    },
    {
      "id": "tuplet-triplet",
      "fixture": "tuplet-triplet",
      "origin": "oud",
      "features": ["tuplets"],
      "proof": {
        "min_events": 4,
        "min_staffs": 1,
        "required_roles": ["notehead", "tuplet"],
        "max_collisions": 0
      },
      "lilypond": {
        "contains": ["\\tuplet 3/2"]
      },
      "petrucci_contract": ["a triplet group gets one bracket that spans its notes"],
      "lilypond_contract": ["a triplet exports as a tuplet block without scaling the bar"],
      "upstream": []
    }
  ]
}
